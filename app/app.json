{
  "expo": {
    "name": "Signalement Lévis",
    "slug": "signalevis",
    "scheme": "signalevis",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.signalevis.app"
    },
    "android": {
      "package": "ca.signalevis.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Signalement Lévis utilise votre position pour proposer les services offerts à cet endroit et indiquer le destinataire prévu de votre signalement."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
