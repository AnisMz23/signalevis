{
  "expo": {
    "name": "Signalement Lévis",
    "slug": "signalevis",
    "scheme": "signalevis",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.signalevis.app",
      "infoPlist": {}
    },
    "android": {
      "package": "ca.signalevis.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Signalement Lévis utilise votre position pour proposer les services offerts à cet endroit et indiquer le destinataire prévu de votre signalement."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "siganleviss-team",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1935a0e8-8194-4993-8e66-23255353b6a3"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1935a0e8-8194-4993-8e66-23255353b6a3"
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
